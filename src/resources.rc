// NARC Engine — Windows resources (icon + version info)
#include <windows.h>

// application icon (shown by Explorer, Arena, taskbar)
1 ICON "assets/NARC-Next.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     4,1,0,0
PRODUCTVERSION  4,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Madushan Dissanayake"
            VALUE "FileDescription",  "NARC Next - UCI Chess Engine"
            VALUE "FileVersion",      "4.1"
            VALUE "InternalName",     "narc-next"
            VALUE "OriginalFilename", "NARC-Next.exe"
            VALUE "ProductName",      "NARC Next"
            VALUE "ProductVersion",   "4.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
